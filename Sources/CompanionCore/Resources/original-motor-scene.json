  "beats": [
    {
      "id": "field",
      "narration": "A simple DC motor has a coil between magnetic poles.",
      "reveal": [
        {
          "node": "fieldPanel",
          "kind": "opacity",
          "from": 0,
          "to": 1,
          "durationMs": 260
        },
        {
          "node": "notes",
          "kind": "opacity",
          "from": 0,
          "to": 1,
          "durationMs": 220
        }
      ],
      "visualTrigger": "firstValidatedVisualBatch",
      "audioMayLagVisual": true
    },
    {
      "id": "forces",
      "narration": "Current on the two sides feels opposite forces. Together, they turn the rotor.",
      "reveal": [
        {
          "node": "forcesPanel",
          "kind": "opacity",
          "from": 0,
          "to": 1,
          "durationMs": 220
        }
      ],
      "visualTrigger": "audioStartOrTextOnlyAdvance"
    },
    {
      "id": "turning",
      "narration": "The split-ring contacts swap the current each half turn, keeping the turning effect in the same direction.",
      "reveal": [
        {
          "node": "commutatorPanel",
          "kind": "opacity",
          "from": 0,
          "to": 1,
          "durationMs": 240
        }
      ],
      "startAnimations": [
        "rotorPhase"
      ],
      "visualTrigger": "audioStartOrTextOnlyAdvance"
    }
  ],
  "animations": [
    {
      "id": "rotorPhase",
      "state": "theta",
      "kind": "integrate",
      "loop": "untilPausedOrWindowClosed",
      "renderRate": "displaySynchronized",
      "reducedMotion": "pauseAtTheta0AndUseStepControls"
    }
  ],
  "controls": [
    {
      "id": "pause",
      "label": "Pause / play",
      "action": {
        "kind": "toggleAnimation",
        "target": "rotorPhase"
      }
    },
    {
      "id": "replay",
      "label": "Replay",
      "action": {
        "kind": "restartScene",
        "phase": 0
      }
    },
    {
      "id": "slow",
      "label": "Half speed",
      "action": {
        "kind": "setParameter",
        "name": "angularSpeed",
        "value": 0.39269908169872414
      }
    },
    {
      "id": "step",
      "label": "Next quarter turn",
      "action": {
        "kind": "pauseThenAdvanceState",
        "name": "theta",
        "delta": 1.5707963267948966
      }
    },
    {
      "id": "askCommutator",
      "label": "Why does the current reverse?",
      "action": {
        "kind": "askFollowUp",
        "text": "Explain why this brushed DC motor reverses the coil current each half turn.",
        "preserveScene": true,
        "focusNodes": [
          "splitRing",
          "forceA",
          "forceB"
        ]
      }
    }
  ],
  "semantics": {
    "fieldWorld": [
      1,
      0,
      0
    ],
    "conductorDirection": "A is +z when currentA is positive; B is its opposite.",
    "worldToScene": "screen x = cx + world x; screen y = cy - world y",
    "forceLaw": "F = I L cross B; A force is +world-y for currentA positive.",
    "torque": "Ideal paired-conductor torque is proportional to currentA*cos(theta).",
    "gap": "Within 3 degrees of a contact dead point, current and displayed force vanish.",
    "simulationLimit": "Phase is prescribed for clarity. Does not model current dynamics, inductance, back EMF, load, friction or acceleration.",
    "source": "https://openstax.org/books/university-physics-volume-2/pages/11-5-force-and-torque-on-a-current-loop"
  }
}
